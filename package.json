{
  "name": "@godcreator/gwb-gitea",
  "version": "0.1.2",
  "author": {"name": "godcreator"},
  "description": "gitea 的通用 HTTP 手：一条命令把 agent 组装好的 API 调用发往配置的 gitea 实例——路径不带 /api/v1、token 由管道注入（住设置）、回执整形；语义住随包发的 skill（cookbook），代码只做管道。服务无；skill 1 份；命令 1 条。",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "skills"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 不构建，少了这条会把上一版的 dist/ 原样发出去——静默的",
    "prepublishOnly": "pnpm build"
  },
  "engines": { "node": ">=24" },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "@godcreator/gwb-commands": "^0.4.3",
    "@godcreator/gwb-settings": "^0.2.1",
    "@godcreator/gwb-skills": "^0.4.1"
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-repo-kit": "0.2.2",
    "@godcreator/gwb-commands": "0.4.3",
    "@godcreator/gwb-settings": "0.2.1",
    "@godcreator/gwb-skills": "0.4.1",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-gitea.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
