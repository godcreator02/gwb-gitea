{
  "name": "@godcreator/gwb-gitea",
  "version": "0.1.0",
  "author": {"name": "godcreator"},
  "description": "gitea 的手：一条 gitea.http 通用命令把 agent 组装好的 API 调用发往配置的 gitea 实例；语义住随包发的说明书（cookbook），代码只做管道",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "skills", "catalog.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 不构建，少了这条会把上一版的 dist/ 原样发出去——静默的",
    "prepublishOnly": "pnpm build"
  },
  "engines": { "node": ">=24" },
  "//peer": "硬依赖 gwbCommands 与 gwbSettings（inject）；gwbSkills 局部注入挂说明书。写 >= 不写 ^：caret 在 0.0.x 锁死 patch",
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": ">=0.1.0",
    "@godcreator/gwb-commands": ">=0.2.0",
    "@godcreator/gwb-settings": ">=0.1.0",
    "@godcreator/gwb-skills": ">=0.3.0"
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "0.1.1",
    "@godcreator/gwb-repo-kit": "0.1.0",
    "@godcreator/gwb-commands": "0.4.0",
    "@godcreator/gwb-settings": "0.2.0",
    "@godcreator/gwb-skills": "0.4.0",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
