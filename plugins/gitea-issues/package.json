{
  "name": "@godcreator/gwb-gitea-issues",
  "version": "0.1.0",
  "description": "gitea issue 窗格：列出设置里几个 owner 名下各仓开着的 issue、看正文与评论；后台定时查新 issue 与新评论，开了推送就经 gwbQqBot 私聊主人",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-gitea.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@cordisjs/plugin-timer": "^1.1.3",
    "@godcreator/gwb-commands": "^0.6.1",
    "@godcreator/gwb-data": "^0.1.12",
    "@godcreator/gwb-gitea": "^0.1.17",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-qq-bot": "^0.6.0",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-shell": "^0.15.11"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-qq-bot": {
      "optional": true
    },
    "@godcreator/gwb-shell": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
