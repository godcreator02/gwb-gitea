{
  "name": "@godcreator/gwb-gitea",
  "version": "0.1.21",
  "author": {"name": "godcreator"},
  "license": "MIT",
  "description": "gitea HTTP 插件：命令 gitea.http 把 agent 组装好的 API 调用发往配置的 gitea 实例，补上 /api/v1、注入 token、整理回执；命令 gitea.push-mirror.add 用设置里的 GitHub token 开推送镜像，token 不经 agent；调用写法与回执读法写在随包发布的说明书里；别的插件注入服务 gwbGitea，和 gitea.http 走同一个发送函数，另能读出地址、推送地址与 token。",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "skills", "LICENSE"],
  "keywords": ["gwb", "gwb-plugin"],
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "engines": { "node": ">=24" },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.10",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.7"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/gwb-gitea.git"
  }
}
