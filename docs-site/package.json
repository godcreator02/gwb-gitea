{
  "name": "gwb-gitea-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gitea 插件的文档站：现状钉在这个仓的源码上，README / AGENTS / CLAUDE 由 docfirst render 生成",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 4326 -H 127.0.0.1",
    "start": "next start -p 4326 -H 127.0.0.1",
    "types:check": "next typegen && tsc --noEmit",
    "docfirst": "docfirst",
    "doc": "docfirst check",
    "doc:confirm": "docfirst confirm",
    "doc:render": "docfirst render",
    "verify:roster": "node scripts/verify-roster.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.14",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@godcreator/docfirst-workflow": "0.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
